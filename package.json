{
  "name": "dsh-os",
  "version": "0.3.0",
  "description": "DeepSeek Harness OS: a whole-GUI theme for the DSH Web interface — conversation flow, sidebar, code blocks, tool cards, dialogs and composer repainted in light and dark through the official theme-token layer, plus a home terminal desktop (ASCII field, boot self-test, live host/harness HUD with a real per-model token ledger) and an in-session telemetry strip. dsh-os：覆盖整个 DSH Web GUI 的主题——会话流、侧边栏、代码块、工具卡、弹窗与输入框用官方 token 层换墨（深浅两套），首页则是一台赛博终端桌面（ASCII 字符场、开机自检、真实系统与会话 Token 账本 HUD），会话内另有遥测条。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "screenshots",
    "screenshots.json"
  ],
  "scripts": {
    "build": "node build.mjs && node --check lib/index.js && node --check lib/client.js",
    "typecheck": "tsc --noEmit",
    "shot": "node tools/shot.mjs",
    "e2e": "dsh-e2e run e2e/smoke.mjs",
    "e2e:session": "dsh-e2e run e2e/session.mjs",
    "prepack": "npm run build",
    "e2e:shots": "dsh-e2e run e2e/shots.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-ui",
    "home",
    "cyberpunk",
    "ascii-art",
    "terminal",
    "crt",
    "monitor",
    "dashboard",
    "telemetry",
    "首页",
    "赛博朋克",
    "字符画",
    "系统监控",
    "theme",
    "gui-theme",
    "skin",
    "telemetry-strip",
    "主题"
  ],
  "author": "johnnren",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~18.3.12",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.25.0",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/john-walks-slow/dsh-os.git"
  },
  "homepage": "https://github.com/john-walks-slow/dsh-os#readme",
  "bugs": {
    "url": "https://github.com/john-walks-slow/dsh-os/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
